rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsDocument(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, create, update: if ownsDocument(uid);
      allow delete: if false;
    }

    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.playerUids == [request.auth.uid]
        && request.resource.data.status == 'waiting';

      allow update: if signedIn() && (
        resource.data.hostUid == request.auth.uid
        || (
          !(request.auth.uid in resource.data.playerUids)
          && request.auth.uid in request.resource.data.playerUids
          && request.resource.data.playerUids.hasAll(resource.data.playerUids)
          && request.resource.data.playerUids.size() == resource.data.playerUids.size() + 1
          && request.resource.data.playerUids.size() <= 2
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['playerUids', 'status', 'updatedAt'])
        )
      );

      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;
    }

    match /matches/{matchId} {
      allow read: if signedIn() && request.auth.uid in resource.data.playerUids;
      allow write: if false;
    }

    match /scores/{scoreId} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
